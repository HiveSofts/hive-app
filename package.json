        "@tauri-apps/api": "^2.11.0",
        "@tauri-apps/plugin-dialog": "^2.7.1",
        "@tauri-apps/plugin-opener": "^2",
        "@types/ora": "^3.2.0",
        "@types/tar": "^7.0.87",
        "@types/unzipper": "^0.10.11",
        "axios": "^1.18.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.40.0",
